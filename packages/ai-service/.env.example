# AI Service Configuration
# Copy this file to .env and fill in your values

# Server Ports
INKBLOOM_GRPC_PORT=50051
INKBLOOM_HTTP_PORT=8100

# LLM Configuration (OpenAI-compatible; DeepSeek recommended)
# Base URL examples: https://api.deepseek.com (DeepSeek) / https://api.openai.com/v1 (OpenAI)
INKBLOOM_OPENAI_API_KEY=your-api-key-here
INKBLOOM_OPENAI_BASE_URL=https://api.deepseek.com
INKBLOOM_DEFAULT_MODEL=deepseek-v4-flash

# Zhipu GLM (optional; required when selecting glm-* models)
# Base URL: https://open.bigmodel.cn/api/paas/v4
INKBLOOM_GLM_API_KEY=your-glm-api-key-here
INKBLOOM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Go Service URL
INKBLOOM_GO_SERVICE_URL=http://localhost:8080
