# AI Service Configuration
# Copy this file to .env and fill in your values

# Server Ports
INKBLOOM_GRPC_PORT=50051
INKBLOOM_HTTP_PORT=8100

# LLM Configuration
INKBLOOM_OPENAI_API_KEY=your-api-key-here
INKBLOOM_OPENAI_BASE_URL=https://api.openai.com/v1
INKBLOOM_DEFAULT_MODEL=gpt-4o-mini

# Go Service URL
INKBLOOM_GO_SERVICE_URL=http://localhost:8080
