# Docker environment variables for InkBloom
# Used with: docker compose --env-file .env.docker up

# Database (internal Docker network)
DATABASE_URL=postgres://inkbloom:inkbloom_dev@postgres:5432/inkbloom?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# AI Service (internal Docker network)
AI_SERVICE_URL=http://ai-service:8100

# Auth
AUTH_TOKEN=inkbloom-dev-token

# LLM Provider (set your keys here or via host env)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://host.docker.internal:11434

# Image Provider
POLLINATIONS_URL=https://image.pollinations.ai
DALLE_API_KEY=
