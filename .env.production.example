# InkBloom 生产环境变量模板（技术方案 v2 §4.1）
# 使用：cp .env.production.example .env.production，填入真实值。
# 注意：.env.production 含密钥，禁止提交仓库。

# ── 数据库 ────────────────────────────────────────────────────────────────
POSTGRES_USER=inkbloom
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=inkbloom

# ── 安全基线（v2 §5.2）────────────────────────────────────────────────────
# JWT HS256 签名密钥：openssl rand -hex 32 生成；缺失时 server 拒绝启动
INKBLOOM_JWT_SECRET=CHANGE_ME_64_hex_chars

# CORS 白名单（v2 §4.2）：逗号分隔的前端域名，例如：
# INKBLOOM_SERVER_CORS_ORIGINS=https://app.inkbloom.cn,https://www.inkbloom.cn
INKBLOOM_SERVER_CORS_ORIGINS=https://app.example.com

# 运营管理员手机号白名单（注册/登录时自动提升 role>=1），逗号分隔
INKBLOOM_ADMIN_PHONES=

# ── LLM Provider（ai-service）─────────────────────────────────────────────
# DeepSeek API Key（兼容 OpenAI 接口）
INKBLOOM_OPENAI_API_KEY=CHANGE_ME_deepseek_api_key
INKBLOOM_OPENAI_BASE_URL=https://api.deepseek.com
INKBLOOM_DEFAULT_MODEL=deepseek-v4-flash

# ── Web 入口端口（前置 LB 回源端口）───────────────────────────────────────
WEB_PORT=80
