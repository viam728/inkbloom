# InkBloom environment variables (copy to .env and fill in).
# NEVER commit the real .env - it is gitignored.

# --- Mandatory ---------------------------------------------------------------
# HS256 signing secret for JWTs and signed asset URLs. Cloud mode refuses to
# boot without it. Generate with: openssl rand -hex 32
INKBLOOM_JWT_SECRET=

# --- LLM providers (ai-service) ----------------------------------------------
# Default model is glm-4.5-air: INKBLOOM_GLM_API_KEY is required for
# default-model traffic. DeepSeek powers the explicit deepseek-* models.
INKBLOOM_GLM_API_KEY=
INKBLOOM_DEEPSEEK_API_KEY=
# Optional base URL override (empty = route by model prefix).
INKBLOOM_AI_BASE_URL=

# --- Operator accounts (optional) --------------------------------------------
# Comma-separated phones auto-promoted to operator role on login/register.
# Ships empty; set real operator phones per deployment.
INKBLOOM_ADMIN_PHONES=

# --- SMS channel (optional; dev = code in server log, never delivered) -------
# dev (default) | aliyun | tencent
INKBLOOM_SMS_PROVIDER=dev
# Aliyun (required when provider=aliyun)
INKBLOOM_SMS_ALIYUN_ACCESS_KEY_ID=
INKBLOOM_SMS_ALIYUN_ACCESS_KEY_SECRET=
INKBLOOM_SMS_ALIYUN_SIGN_NAME=
INKBLOOM_SMS_ALIYUN_TEMPLATE_CODE=
# Tencent (required when provider=tencent)
INKBLOOM_SMS_TENCENT_SECRET_ID=
INKBLOOM_SMS_TENCENT_SECRET_KEY=
INKBLOOM_SMS_TENCENT_SDK_APP_ID=
INKBLOOM_SMS_TENCENT_SIGN_NAME=
INKBLOOM_SMS_TENCENT_TEMPLATE_ID=

# --- Payment channels (optional; sandbox is local-mode only) -----------------
# Alipay (leave empty to keep the channel closed)
INKBLOOM_ALIPAY_APP_ID=
INKBLOOM_ALIPAY_PRIVATE_KEY=
INKBLOOM_ALIPAY_PUBLIC_KEY=
INKBLOOM_ALIPAY_NOTIFY_URL=
# WeChat Pay v3 (leave empty to keep the channel closed)
INKBLOOM_WECHAT_APP_ID=
INKBLOOM_WECHAT_MCH_ID=
INKBLOOM_WECHAT_CERT_SERIAL_NO=
INKBLOOM_WECHAT_PRIVATE_KEY=
INKBLOOM_WECHAT_APIV3_KEY=
INKBLOOM_WECHAT_NOTIFY_URL=
